{
  "name": "lerna-ci",
  "version": "2.1.0",
  "description": "Monorepo dependency synchronization and release preflight checks for pnpm, npm, and Yarn",
  "author": "Saiya",
  "repository": "https://github.com/oe/lerna-ci.git",
  "homepage": "https://github.com/oe/lerna-ci#readme",
  "bugs": {
    "url": "https://github.com/oe/lerna-ci/issues"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": "./dist/bin/index.js",
  "scripts": {
    "dev": "tsx test/index.ts",
    "dev:build": "vite build --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/prepare-dist.cjs",
    "prepack": "pnpm run lint && tsc -p tsconfig.tools.json && pnpm run build",
    "test": "pnpm run lint && tsc -p tsconfig.tools.json && pnpm run build && node test/regression.cjs",
    "test:regression": "node test/regression.cjs",
    "release": "pnpm publish",
    "test:package": "pnpm pack --out pack.tgz && node test/package-smoke.cjs pack.tgz",
    "test:catalog": "node test/catalog-smoke.cjs"
  },
  "dependencies": {
    "cosmiconfig": "^8.3.6",
    "cross-spawn": "^7.0.6",
    "detect-indent": "^6.1.0",
    "find-packages": "^10.0.4",
    "fixpack": "^4.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=14.6"
  },
  "keywords": [
    "dependencies",
    "dependency-sync",
    "dependency-updates",
    "workspaces",
    "package-json",
    "semver",
    "catalogs",
    "pnpm-catalog",
    "release",
    "preflight",
    "changesets",
    "ci",
    "lerna",
    "yarn",
    "pnpm",
    "npm",
    "monorepo"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
